# dataset: subquery_cases

query T
SELECT name FROM customers WHERE id IN (SELECT customer_id FROM orders WHERE total >= 25) ORDER BY name;
----
Alpha
Beta

query TI
SELECT name, (SELECT COUNT(*) FROM orders) AS total_orders FROM customers ORDER BY id;
----
Alpha	3
Beta	3
Gamma	3

statement error
SELECT name, (SELECT customer_id FROM orders) AS any_customer FROM customers ORDER BY id;

statement error
SELECT name, (SELECT id, customer_id FROM orders LIMIT 1) FROM customers ORDER BY id;

statement error
SELECT name, COALESCE((SELECT COUNT(*) FROM orders), 0) FROM customers ORDER BY id;
