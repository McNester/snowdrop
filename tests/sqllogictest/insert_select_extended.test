# dataset: insert_select_cases

query TTTT
INSERT INTO archive_orders (id, customer, total, status) WITH staged AS (SELECT id, customer, total, UPPER(status) AS status FROM live_orders WHERE total >= 50) SELECT id, customer, total, status FROM staged ORDER BY id; SELECT id, customer, total, status FROM archive_orders ORDER BY id;
----
1	Alice	75	PAID
3	Cara	120	PENDING

query TI
INSERT INTO customer_totals (customer, total) SELECT customer, SUM(total) AS total FROM live_orders GROUP BY customer ORDER BY customer; SELECT customer, total FROM customer_totals ORDER BY customer;
----
Alice	75
Bob	20
Cara	120

