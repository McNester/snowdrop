# dataset: lateral_cases

query TT
SELECT c.name, recent.total FROM customers c INNER JOIN LATERAL (SELECT o.total FROM orders o WHERE o.customer_id = c.id AND o.status = 'paid' ORDER BY o.total DESC LIMIT 1) AS recent ON TRUE ORDER BY c.name;
----
Alpha	75
Gamma	40

query TT
SELECT c.name, recent.total FROM customers c LEFT JOIN LATERAL (SELECT o.total FROM orders o WHERE o.customer_id = c.id AND o.status = 'paid' ORDER BY o.total DESC LIMIT 1) AS recent ON TRUE ORDER BY c.name;
----
Alpha	75
Beta	NULL
Gamma	40

